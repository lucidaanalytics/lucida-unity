  {"reason": "condition_match", "condition": {"rollout_pct": 20}, "expect": "SPLIT"},
  {"reason": "condition_match", "condition": {"rollout_pct": 100}, "type": "multivariate", "expect": "SPLIT"},
  {"reason": "condition_match", "condition": {"rollout_pct": 100, "variant_override": "a"}, "type": "multivariate", "expect": "STATIC"},
