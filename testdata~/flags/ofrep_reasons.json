  {"reason": "holdout", "expect": "SPLIT"},
  {"reason": "namespace_excluded", "expect": "SPLIT"},
  {"reason": "preview", "expect": "TARGETING_MATCH"},
  {"reason": "user_preview", "expect": "TARGETING_MATCH"},
  {"reason": "condition_match", "condition": {"filters": [{"type": "person", "key": "plan", "op": "eq", "value": "pro"}], "rollout_pct": 100}, "expect": "TARGETING_MATCH"},
